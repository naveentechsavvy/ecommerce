# Normalise line endings so Windows, macOS and Linux clones behave the same
* text=auto eol=lf

# Windows scripts must keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Unix scripts must keep LF (mvnw fails with "bad interpreter" otherwise)
mvnw text eol=lf
*.sh text eol=lf

*.png binary
*.jpg binary
*.jar binary
